@{
    ViewData["Title"] = "About VroomParts";
}
<h1 class="about-title">@ViewData["Title"]</h1>

<style>
    body {
        background-color: #111;
        color: #ccc;
        font-family: 'Segoe UI', sans-serif;
        margin: 0;
        padding: 0;
    }

    .about-container {
        font-size: 1.1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        max-width: 1200px;
        margin: 0 auto;
        padding: 60px 20px;
        text-align: justify;
    }

    .about-image {
        width: 80%;
        max-width: 800px;
        margin-bottom: 40px;
        position: relative;
    }

        .about-image img {
            width: 100%;
            border-radius: 20px;
            box-shadow: 0 0 30px rgba(255, 30, 250, 0.4);
        }

    .about-text {
        width: 100%;
    }

    .section {
        margin-bottom: 40px;
    }

    .about-text h3 {
        font-size: 2rem;
        margin-bottom: 15px;
    }

    .about-text p,
    .about-text ul {
        font-size: 1.2rem;
        color: #ddd;
        line-height: 1.7;
        margin: 10px 0;
        text-align: justify;
    }

    .about-text ul {
        padding-left: 20px;
    }

    .about-title {
        text-align: center;
        font-size: 3rem;
        margin-top: 40px;
        color: #fff;
    }
</style>

<div class="about-container">
    <div class="about-image">
        <img src="/images/m5.jpg" alt="BMW E60 M5 Headlights">
    </div>

    <div class="about-text">
        <div class="section">
            <h3>🔧 Who are we?</h3>
            <p>
                VroomParts is a dedicated team of car enthusiasts, born out of a passion for customizing and enhancing our own vehicles.
                What began as a small hobby project has evolved into a thriving business that serves car lovers everywhere.
            </p>
        </div>

        <div class="section">
            <h3>📈 Our Journey</h3>
            <p>
                It all started with a single BMW E46 in a modest garage. As word spread among friends, our passion project grew.
                Today, VroomParts is recognized for offering top-quality parts and customization solutions.
            </p>
        </div>

        <div class="section">
            <h3>🛠 Our Offerings</h3>
            <ul>
                <li>High-performance lighting and LED upgrades</li>
                <li>Premium audio and multimedia solutions</li>
                <li>Advanced touchscreens and GPS systems</li>
                <li>Performance tuning, including exhausts, chip tuning, and body kits</li>
                <li>Personalized recommendations for every car make and model</li>
            </ul>
        </div>

        <div class="section">
            <h3>🚗 Your Ride, Your Identity</h3>
            <p>
                At VroomParts, we believe that a car should reflect the driver’s unique style. We are passionate about helping you make your ride truly yours.
                Explore our catalog and join the growing community of automotive enthusiasts who trust us to enhance their driving experience.
            </p>
        </div>
    </div>
</div>