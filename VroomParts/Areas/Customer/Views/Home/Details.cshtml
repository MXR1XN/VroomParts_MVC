@using VroomParts.Areas.Customer.ViewModels
@model ProductViewModel

@{
    ViewData["Title"] = Model.Name;
}

<style>
    .product-card {
        background-color: #1c1c1c;
        color: #fff;
        border: 1px solid #ffc107;
        border-radius: 1rem;
        box-shadow: 0 0 20px rgba(255, 193, 7, 0.3);
        padding: 2rem;
    }

    .product-title {
        color: #ffc107;
        font-size: 2rem;
        font-weight: bold;
        margin-bottom: 1rem;
    }

    .product-price {
        font-size: 1.5rem;
        font-weight: bold;
        color: #ffc107;
    }

    .product-description {
        margin-top: 1rem;
        margin-bottom: 1.5rem;
        color: #ccc;
    }

    .product-compatibility {
        font-size: 0.95rem;
        color: #999;
        margin-bottom: 1rem;
    }

    .btn-buy {
        background-color: #ffc107;
        border: none;
        color: #000;
    }

        .btn-buy:hover {
            background-color: #ff8800;
        }

    .btn-back {
        background-color: #343a40;
        color: #fff;
    }

        .btn-back:hover {
            background-color: #ffc107;
            color: #000;
        }

    .form-control {
        background-color: #2c2f33;
        color: #fff;
        border: 1px solid #ffc107;
    }

        .form-control:focus {
            border-color: #ffc107;
            box-shadow: 0 0 5px rgba(255, 193, 7, 0.6);
        }
</style>

<form method="post" asp-action="Details" asp-controller="Home">
    <input type="hidden" asp-for="Id" />

    <div class="container mt-5">
        <div class="mb-3">
            <a asp-area="Customer" asp-controller="Welcome" asp-action="Index"
               asp-route-make="@Context.Request.Query["make"]"
               asp-route-model="@Context.Request.Query["model"]"
               asp-route-year="@Context.Request.Query["year"]"
               class="btn btn-outline-light">
                <i class="bi bi-arrow-left-circle"></i> Back to Search
            </a>
        </div>

        <div class="product-card row">
            <div class="col-md-5 text-center mb-3">
                <img src="@Model.ImageUrl" class="img-fluid rounded" style="max-height: 300px; object-fit: contain;" onerror="this.src='/images/default-placeholder.png'" />
            </div>

            <div class="col-md-7">
                <div class="product-title">@Model.Name</div>
                <div class="product-price">$@Model.Price.ToString("0.00")</div>
                <div class="product-description">@Html.Raw(Model.Description)</div>

                <div class="product-compatibility">
                    <strong>Compatible with:</strong>
                    @if (Model.VehicleCompatibility != null && Model.VehicleCompatibility.Any())
                    {
                        <ul class="mb-0">
                            @foreach (var v in Model.VehicleCompatibility)
                            {
                                <li>@v.Make @v.Model (@v.Year)</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span>Not specified</span>
                    }
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Quantity</label>
                        <input asp-for="Quantity" type="number" min="1" value="1" class="form-control" />
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-buy w-50">Add to Cart</button>
                    <a asp-action="Index"
                       asp-route-MinPrice="@Context.Request.Query["MinPrice"]"
                       asp-route-MaxPrice="@Context.Request.Query["MaxPrice"]"
                       asp-route-SearchPart="@Context.Request.Query["SearchPart"]"
                       asp-route-PartPartCompatibility="@Context.Request.Query["PartPartCompatibility"]"
                       asp-route-CategoryIds="@string.Join(",", Context.Request.Query["CategoryIds"])"
                       class="btn btn-back w-50">
                        Back to Shop
                    </a>
                </div>
            </div>
        </div>
    </div>

</form>
