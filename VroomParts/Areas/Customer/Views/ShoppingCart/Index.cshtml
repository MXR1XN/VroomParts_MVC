@using VroomParts.Models.ShoppingCart
@model ShoppingCartVM

<form method="post">
    <br />
    <div class="card shadow border-0">
        <div class="card-header bg-secondary bg-gradient text-light ml-0 py-4">
            <div class="row px-4">
                <div class="col-6">
                    <h3 class="pt-2 text-white">Shopping Cart</h3>
                </div>
                <div class="col-md-2 ms-auto text-end">
                    <a asp-area="Customer" asp-controller="Home" asp-action="Index"
                       class="btn btn-outline-dark text-uppercase fw-bold py-3 px-5">
                        Continue Shopping
                    </a>
                </div>

            </div>
        </div>

        <div class="card-body my-4">
            <div class="row mb-3 pb-3">
               

                <div class="col-md-10 offset-md-1">
                    @foreach (var item in Model.ShoppingCartList)
                    {
                        <div class="row align-items-center border-bottom pb-3 mb-3">
                            <!-- Image Section (Left) -->
                            <div class="col-md-3 text-center">
                                <img src="@item.CarPart.ImageUrl" class="rounded w-100"
                                     style="max-height: 200px; object-fit: contain;"
                                     onerror="this.src='/images/default-placeholder.png'" />
                            </div>

                            <!-- Details Section (Right) -->
                            <div class="col-md-6">
                                <h5 class="text-uppercase text-secondary"><strong>@item.CarPart.Name</strong></h5>
                                <p class="text-muted"><small>@Html.Raw(item.CarPart.Description)</small></p>
                            </div>

                            <!-- Price & Controls -->
                            <div class="col-md-3 text-center">
                                <h6 class="fw-semibold mb-2">
                                    @item.CarPart.Price.ToString("c")
                                    <span class="text-muted">&nbsp;x&nbsp;</span>@item.Count
                                </h6>
                                <div class="btn-group" role="group">

                                    <a asp-action="plus" asp-route-cartId="@item.Id" class="btn btn-outline-primary bg-gradient py-2">
                                        <i class="bi bi-plus-square"></i>
                                    </a>

                                    <a asp-action="minus" asp-route-cartId="@item.Id" class="btn btn-outline-primary bg-gradient py-2">
                                        <i class="bi bi-dash-square"></i>
                                    </a>

                                    <a asp-action="remove" asp-route-cartId="@item.Id" class="btn btn-danger bg-gradient py-2">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>

                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="card-footer bg-white border-0">
                <div class="row">
                    <div class="col-md-4 offset-md-4">
                        <ul class="list-group mb-4">
                            <li class="d-flex justify-content-between align-items-center">
                                <h5 class="text-dark fw-semibold text-uppercase">Total (USD)</h5>
                                <h4 class="text-dark fw-bolder">@Model.OrderHeader.OrderTotal.ToString("c")</h4>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-2 offset-md-5">
                        <a asp-action="Summary" class="btn btn-primary border-0 bg-gradient w-100 py-2">Summary</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
