@using VroomParts.Areas.Customer.ViewModels
@model CartProductsViewModel

<form method="post">
    <br />
    <div class="card shadow border-0">
        <div class="card-header bg-secondary bg-gradient text-light ml-0 py-4">
            <div class="row px-4">
                <div class="col-6">
                    <h3 class="pt-2 text-white">Shopping Cart</h3>
                </div>
                <div class="col-md-2 ms-auto text-end">
                    <a asp-area="Customer" asp-controller="Home" asp-action="Index"
                       class="btn btn-outline-dark text-uppercase fw-bold py-3 px-5">
                        Continue Shopping
                    </a>
                </div>
            </div>
        </div>

        <div class="card-body my-4">
            @if (Model.Products == null || !Model.Products.Any())
            {
                <div class="text-center my-5">
                    <h4 class="text-muted">Your cart is empty. Please add some products first.</h4>
                </div>
            }
            else
            {
                <div class="row mb-3 pb-3">
                    <div class="col-md-10 offset-md-1">
                        @foreach (var item in Model.Products)
                        {
                            <div class="row align-items-center border-bottom pb-3 mb-3">
                                <div class="col-md-3 text-center">
                                    <img src="@item.ImageUrl" class="rounded w-100"
                                         style="max-height: 200px; object-fit: contain;"
                                         onerror="this.src='/images/default-placeholder.png'" />
                                </div>

                                <div class="col-md-6">
                                    <h5 class="text-uppercase text-secondary"><strong>@item.Name</strong></h5>
                                    <p class="text-muted"><small>@Html.Raw(item.Description)</small></p>
                                </div>

                                <div class="col-md-3 text-center">
                                    <h6 class="fw-semibold mb-2">
                                        @item.Price.ToString("c")
                                        <span class="text-muted">&nbsp;x&nbsp;</span>@item.Quantity
                                    </h6>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Plus" asp-route-carPartId="@item.Id"
                                           class="btn btn-outline-primary bg-gradient py-2">
                                            <i class="bi bi-plus-square"></i>
                                        </a>

                                        <a asp-action="Minus" asp-route-carPartId="@item.Id"
                                           class="btn btn-outline-primary bg-gradient py-2">
                                            <i class="bi bi-dash-square"></i>
                                        </a>

                                        <a asp-action="Remove" asp-route-carPartId="@item.Id"
                                           class="btn btn-danger bg-gradient py-2">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="card-footer bg-white border-0">
                    <div class="row">
                        <div class="col-md-4 offset-md-4">
                            <ul class="list-group mb-4">
                                <li class="d-flex justify-content-between align-items-center">
                                    <h5 class="text-dark fw-semibold text-uppercase">Total (USD)</h5>
                                    <h4 class="text-dark fw-bolder">@Model.TotalPrice.ToString("c")</h4>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 offset-md-5">
                            <a asp-action="Summary" class="btn btn-primary border-0 bg-gradient w-100 py-2">Summary</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</form>
