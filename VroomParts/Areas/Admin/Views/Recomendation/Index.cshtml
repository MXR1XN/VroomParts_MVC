@using VroomParts.Areas.Admin.ViewModels
@model RecomendationsViewModel

@{
    ViewData["Title"] = "Manage Recommendations";
}

<h2 class="text-center text-info mb-4">Manage Recommendations</h2>

<div class="d-flex justify-content-center">
    <div class="col-md-8">
        <form asp-action="Add" method="post" class="bg-dark text-light p-4 rounded mb-4 shadow">
            <h4 class="mb-3">Add Recommendation</h4>

            <div class="mb-3">
                <label>Select Car</label>
                <select asp-for="SelectedCarId" class="form-select" required>
                    <option value="">-- Choose Car --</option>
                    @foreach (var car in Model.Cars)
                    {
                        <option value="@car.Id">@car.Make @car.Model (@car.Year)</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label>Select Part</label>
                <select asp-for="SelectedPartId" class="form-select" required>
                    <option value="">-- Choose Part --</option>
                    @foreach (var part in Model.Parts)
                    {
                        <option value="@part.Id">@part.Name</option>
                    }
                </select>

            </div>

            <div class="text-center mb-3">
                <img id="partImagePreview" src="#" alt="Selected part image" style="max-height: 200px; display: none;" class="img-fluid rounded shadow" />
            </div>

            <button class="btn btn-success w-100" type="submit">Add</button>
        </form>
    </div>
</div>

<hr />

<h4 class="text-center text-white">Current Recommendations</h4>

<table class="table table-bordered table-dark table-striped">
    <thead>
        <tr>
            <th>Car</th>
            <th>Model</th>
            <th>Part</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Recomendations)
        {
            <tr>
                <td>@item.VehicleMake</td>
                <td>@item.VehicleModel</td>
                <td>@item.CarPartName</td>
                <td>
                    <form asp-action="Delete" method="post" style="display:inline">
                        <input type="hidden" name="carId" value="@item.VehicleId" />
                        <input type="hidden" name="partId" value="@item.CarPartId" />
                        <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
@if (Model.MissingRecommendations.Any())
{
    <hr />
    <h4 class="text-center text-warning">Missing Recommendations</h4>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Make</th>
                <th>Model</th>
                <th>Year</th>
                <th>Reported</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var missing in Model.MissingRecommendations)
            {
                <tr>
                    <td>@missing.Make</td>
                    <td>@missing.Model</td>
                    <td>@missing.Year</td>
                    <td>@missing.CreatedAt.ToString("g")</td>
                    <td>
                        <form asp-action="RemoveMissingRecommendations" method="post" style="display:inline">
                            <input type="hidden" name="missingRecomendationId" value="@missing.Id" />
                            <button class="btn btn-danger btn-sm" type="submit">
                                <i class="bi bi-x-circle"></i> Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

