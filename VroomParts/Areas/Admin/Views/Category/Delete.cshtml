@using VroomParts.Areas.Admin.ViewModels
@model CategoryViewModel

<h2 class="text-danger text-center">Delete Category</h2>

<div class="p-4 bg-dark text-light rounded">
    <p>Are you sure you want to delete the category <strong>@Model.Name</strong>?</p>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="text-end">
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash"></i> Delete
            </button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
