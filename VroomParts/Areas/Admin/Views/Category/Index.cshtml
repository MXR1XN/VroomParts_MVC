@using VroomParts.Areas.Admin.Application.Categories
@model List<CategoryDTO>

<h2 class="text-primary text-center">Available Categories</h2>

<div class="text-end mb-3">
    <a asp-action="Create" class="btn btn-success">
        <i class="fas fa-plus"></i> Add New Category
    </a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning text-center">
        ⚠ No categories available.
    </div>
}
else
{
    <table class="table table-striped table-dark">
        <thead>
            <tr>
                <th>Name</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Name</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-warning">
                            <i class="fas fa-edit"></i> Edit
                        </a>

                        <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-danger">
                            <i class="fas fa-trash"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
