@using VroomParts.Areas.Admin.Application.Categories
@model CategoryDTO

<h2 class="text-primary text-center">Edit Category</h2>

<form asp-action="Edit" method="post" class="p-4 bg-dark text-light rounded">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label for="categoryName" class="form-label">Category Name</label>
        <input type="text" asp-for="Name" class="form-control" required>
    </div>

    <div class="text-end">
        <button type="submit" class="btn btn-warning">
            <i class="fas fa-edit"></i> Update
        </button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
