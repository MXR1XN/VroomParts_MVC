@using VroomParts.Areas.Admin.ViewModels
@model List<VehicleViewModel>

@{
    ViewData["Title"] = "Vehicles";
}

<h2>Vehicles</h2>
<a class="btn btn-primary mb-3" asp-action="Create">+ Add New Vehicle</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Make</th>
            <th>Model</th>
            <th>Year</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var vehicle in Model)
        {
            <tr>
                <td>@vehicle.Make</td>
                <td>@vehicle.Model</td>
                <td>@vehicle.Year</td>
                <td>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@vehicle.Id">Edit</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@vehicle.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
