@using VroomParts.Areas.Admin.ViewModels
@model List<CarPartViewModel>

<h2 class="text-primary text-center">Available Car Parts</h2>

<form method="get" asp-action="Index" id="filterForm" class="mb-4">
    <div class="d-flex flex-wrap gap-3 align-items-center">

        <div class="d-flex align-items-center">
            <label class="me-2">Category:</label>
            @foreach (var category in ViewBag.Categories)
            {
                <div class="form-check form-check-inline">
                    <input type="checkbox" name="CategoryIds" value="@category.Id"
                           class="form-check-input category-checkbox"
                    @(ViewBag.SelectedCategories.Contains(category.Id) ? "checked" : "") />
                    <label class="form-check-label">@category.Name</label>
                </div>
            }
        </div>

        <div>
            <label class="me-2">Part Name:</label>
            <input type="text" name="SearchPart" class="form-control d-inline-block w-auto"
                   value="@Context.Request.Query["SearchPart"]" />
        </div>

        <div>
            <label class="me-2">Vehicle:</label>
            <input type="text" name="PartPartCompatibility" class="form-control d-inline-block w-auto"
                   value="@Context.Request.Query["PartPartCompatibility"]" />
        </div>

        <button type="submit" class="btn btn-primary">Apply</button>
    </div>
</form>



<div class="text-end mb-3">
    <a asp-action="Create" class="btn btn-success">
        <i class="fas fa-plus"></i> Add New Car Part
    </a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning text-center">
        ⚠ No car parts available in the selected categories.
    </div>
}
else
{
    <div class="row">
        @foreach (var part in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card bg-dark text-light">
                    <div class="card-body">
                        <h5 class="card-title">@part.Name</h5>
                        <p><strong>Price:</strong> $@part.Price</p>
                        <p>@part.Description</p>
                        <p>
                            <strong>Fits:</strong>
                            @if (part.VehicleCompatibility.Any())
                            {
                                <ul>
                                    @foreach (var v in part.VehicleCompatibility)
                                    {
                                        <li>
                                            <span class="text-info">@v.Make</span>
                                            <span class="text-info">@v.Model</span>
                                            <span class="text-info">(@v.Year)</span>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span class="text-warning">No vehicle compatibility listed</span>
                            }
                        </p>



                        @if (!string.IsNullOrEmpty(part.ImageUrl))
                        {
                            <div class="image-container">
                                <img src="@part.ImageUrl" class="car-part-img" />
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No Image Available</p>
                        }

                        <a class="btn btn-warning" asp-action="Edit" asp-route-id="@part.Id">
                            <i class="fas fa-edit"></i> Edit
                        </a>

                        <a class="btn btn-danger" asp-action="Delete" asp-route-id="@part.Id">
                            <i class="fas fa-trash"></i> Delete
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<script>
    document.addEventListener("DOMContentLoaded", function () {
        updateAllCategoriesCheckbox();

        function updateAllCategoriesCheckbox() {
            var allCheckbox = document.getElementById("allCategories");
            var categoryCheckboxes = document.querySelectorAll(".category-checkbox");

            var allChecked = Array.from(categoryCheckboxes).every(cb => cb.checked);
            allCheckbox.checked = allChecked;
        }

        function toggleAllCategories() {
            var allCheckbox = document.getElementById("allCategories");
            var categoryCheckboxes = document.querySelectorAll(".category-checkbox");

            categoryCheckboxes.forEach(cb => {
                cb.checked = allCheckbox.checked;
            });
        }

        document.querySelectorAll(".category-checkbox").forEach(cb => {
            cb.addEventListener("change", updateAllCategoriesCheckbox);
        });
    });
</script>
