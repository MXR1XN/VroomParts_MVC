@using VroomParts.Areas.Admin.Application;
@using VroomParts.Areas.Admin.Application.CarParts
@model CarPartDTO

@{
    ViewData["Title"] = "Add New Car Part";
}

<h2 class="text-warning text-center">Add a New Car Part</h2>

<form method="post" asp-action="Create">
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input type="text" class="form-control" name="Name" required>
    </div>

    <div class="mb-3">
        <label class="form-label">Price</label>
        <input type="number" class="form-control" name="Price" step="0.01" required>
    </div>

    <div class="mb-3">
        <label class="form-label">Category</label>
        <select name="CategoryId" class="form-select" required>
            <option value="">-- Select Category --</option>
            @foreach (var category in ViewBag.Categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea class="form-control" name="Description" rows="3" required></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Vehicle Compatibility</label>
        <input type="text" class="form-control" name="VehicleCompatibility" required>
    </div>

    <div class="mb-3">
        <label class="form-label">Image URL</label>
        <input type="url" class="form-control" name="ImageUrl" id="imageUrlInput">
        <div class="mt-2">
            <img id="imagePreview" class="img-thumbnail" width="150" style="display:none;">
        </div>
    </div>

    <button type="submit" class="btn btn-success">Create</button>
</form>

<script>
    document.getElementById("imageUrlInput").addEventListener("input", function () {
        let imagePreview = document.getElementById("imagePreview");
        if (this.value) {
            imagePreview.src = this.value;
            imagePreview.style.display = "block";
        } else {
            imagePreview.style.display = "none";
        }
    });
</script>
