@using VroomParts.Areas.Admin.Application;
@using VroomParts.Areas.Admin.Application.CarParts
@model CarPartDTO

@{
    ViewData["Title"] = "Edit Car Part";
}

<h2 class="text-warning text-center">Edit Car Part</h2>

<form method="post" asp-action="Edit">
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="mb-3">
        <label class="form-label">Name</label>
        <input type="text" class="form-control" name="Name" value="@Model.Name" required>
    </div>

    <div class="mb-3">
        <label class="form-label">Price</label>
        <input type="number" class="form-control" name="Price" step="0.01" value="@Model.Price" required>
    </div>

    <div class="mb-3">
        <label class="form-label">Category</label>
        <select name="CategoryId" class="form-select" required>
            <option value="">-- Select Category --</option>
            @foreach (var category in ViewBag.Categories)
            {
                <option value="@category.Id" selected="@(Model.CategoryId == category.Id ? "selected" : null)">
                    @category.Name
                </option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea class="form-control" name="Description" rows="3" required>@Model.Description</textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Vehicle Compatibility</label>
        <input type="text" class="form-control" name="VehicleCompatibility" value="@Model.VehicleCompatibility" required>
    </div>

    <div class="mb-3">
        <label class="form-label">Image URL</label>
        <input type="url" class="form-control" name="ImageUrl" value="@Model.ImageUrl">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="mt-2">
                <img src="@Model.ImageUrl" alt="Product Image" class="img-thumbnail" width="150">
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>
