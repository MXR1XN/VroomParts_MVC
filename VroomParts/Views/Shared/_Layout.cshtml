@using VroomParts.Utility
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VroomParts</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://kit.fontawesome.com/a076d05399.js"></script>
</head>
<body>
    <!-- ✅ Navigation Panel -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand text-warning fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-car"></i> VroomParts
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <!-- ✅ Home Page -->
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Customer" asp-controller="Welcome" asp-action="Index">
                                <i class="fas fa-home"></i> Welcome
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Customer" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home"></i> Products
                            </a>
                        </li>

                        <a class="nav-link text-light" asp-area="Customer" asp-controller="Home" asp-action="About">
                            About Us
                        </a>

                        @if (User.IsInRole(StaticDetail.Role_Admin))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-cog"></i> Admin Panel
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark bg-dark border-0" aria-labelledby="adminDropdown">
                                    <li>
                                        <a class="dropdown-item text-light" asp-area="Admin" asp-controller="CarPart" asp-action="Index">
                                            <i class="fas fa-tools"></i> Car Parts
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-light" asp-area="Admin" asp-controller="Category" asp-action="Index">
                                            <i class="fas fa-list"></i> Categories
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-light" asp-area="Admin" asp-controller="Vehicle" asp-action="Index">
                                            <i class="fas fa-car"></i> Vehicles
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-light" asp-area="Admin" asp-controller="Recomendation" asp-action="Index">
                                            <i class="fas fa-thumbs-up"></i> Recommendations
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link" asp-area="Customer" asp-controller="ShoppingCart" asp-action="Index">
                                <i class="bi bi-cart"> </i> Shopping Cart &nbsp (0) 
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-area="Customer" asp-controller="Order" asp-action="Index">
                                <i class="fas fa-list"></i> Orders
                            </a>
                        </li>
                        <!-- ✅ Privacy Policy -->
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Customer" asp-controller="Home" asp-action="Privacy">
                                <i class="fas fa-user-shield"></i> Privacy Policy
                            </a>
                        </li>
                    </ul>


                    <partial name = "_LoginPartial"/>

                </div>
            </div>
        </nav>
    </header>

    <!-- ✅ Main Content -->
    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- ✅ Footer -->
    <footer class="bg-dark text-white text-center py-3 mt-5">
        <div class="container">
            <p>&copy; @DateTime.Now.Year - VroomParts. All rights reserved.</p>
        </div>
    </footer>

    <!-- ✅ Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
